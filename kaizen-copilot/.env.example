# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables.
# Never put real values in this file — it is committed to git.

# OpenAI API key (server-side only, never exposed to the browser)
OPENAI_API_KEY=

# Extraction model (default gpt-6.1-sol; the prototype was evaluated on gpt-6-luna)
OPENAI_MODEL=gpt-6-luna
# Optional reasoning effort: minimal | low | medium | high
EXTRACT_EFFORT=

# List prices per 1M tokens for the model above - used only for cost reporting
PRICE_INPUT_PER_M=0.10
PRICE_OUTPUT_PER_M=0.50
PRICE_CACHED_INPUT_PER_M=0.02

# Shared demo password for the login screen (S2)
DEMO_PASSWORD=

# Random string used to sign session cookies: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kill switch (G17): set to false to stop all live AI processing instantly
AI_ENABLED=true
